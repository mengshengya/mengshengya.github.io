---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { ifacWc2026 as project, ifacWc2026Citation } from '../../data/ifacWc2026';
import { profile } from '../../data/profile';
import { Content } from '../../content/projects/ifac-wc-2026.md';
import '../../styles/project.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`IFAC WC 2026 | ${project.title}`} description={project.summary}>
  <header class="site-header">
    <div class="header-inner container project-header">
      <a class="brand" href={`${base}/`}><span>{profile.name}</span></a>
      <a class="text-link" href={`${base}/#research`}><span aria-hidden="true">←</span> Back to research</a>
    </div>
  </header>

  <main id="main-content" class="project-container">
    <section class="project-hero" aria-labelledby="project-title">
      <p class="eyebrow"><span></span>{project.venue} · {project.year}</p>
      <h1 id="project-title">{project.title}</h1>
      <p class="project-authors">{project.authors.map((author, index) => <>{index > 0 && <span class="author-separator"> · </span>}{author === profile.name ? <a href={`${base}/`}>{author}</a> : author}</>)}</p>
      <p class="project-affiliation">{project.affiliation}</p>
      <p class="project-journal">{project.location} · {project.date}</p>
      <div class="project-actions">
        <a class="button button-primary" href="#demonstration">Compare platform recordings <span aria-hidden="true">↓</span></a>
        <a class="button button-outline" href="#system-scheme">View experimental scheme <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="#citation">Cite this work</a>
      </div>
    </section>

    <figure id="system-scheme" class="project-cover">
      <a href={`${base}${project.cover.source}`} target="_blank" rel="noopener noreferrer" aria-label="Open the experimental scheme at full size">
        <img src={`${base}${project.cover.source}`} alt={project.cover.alt} width={project.cover.width} height={project.cover.height} fetchpriority="high" />
      </a>
      <figcaption>Trust-aware cooperative state estimation: experimental scheme. <a href={`${base}${project.cover.source}`} target="_blank" rel="noopener noreferrer">View full size <span aria-hidden="true">↗</span></a></figcaption>
    </figure>

    <section class="section-panel project-overview" aria-label="Research overview">
      <p class="project-summary">{project.summary}</p>
      <div class="project-prose"><Content /></div>
    </section>

    <section id="demonstration" class="project-section" aria-labelledby="demonstration-title">
      <div class="project-section-heading"><p class="small-label">Platform comparison</p><h2 id="demonstration-title">Without and with rollback</h2><p>The companion recordings contrast the estimate retained after a delayed trust decision with the finite-window replay used to revise recent observer updates.</p></div>
      <div class="demo-list comparison-demo-grid">
        {project.comparisonVideos.map((video, index) => (
          <article class="demo-card" aria-labelledby={`${video.id}-title`}>
            <div class="demo-heading"><span class="section-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3 id={`${video.id}-title`}>{video.title}</h3><span class="demo-label">QCar/LIMO platform</span></div>
            <div class="video-frame">
              <video class="video-four-three" controls playsinline preload="metadata" width={video.width} height={video.height} aria-labelledby={`${video.id}-title`} aria-describedby={`${video.id}-description`}>
                <source src={`${base}${video.source}`} type="video/mp4" />
                Your browser does not support embedded video. <a href={`${base}${video.source}`}>Download the MP4 recording.</a>
              </video>
            </div>
            <div class="demo-caption"><p id={`${video.id}-description`}>{video.description}</p><a href={`${base}${video.source}`} download>Download video <Icon name="arrow" size={14} /></a></div>
          </article>
        ))}
      </div>
    </section>

    <section id="results" class="section-panel project-results" aria-labelledby="results-title">
      <div class="project-section-heading"><p class="small-label">Experimental results</p><h2 id="results-title">What the reported tests show</h2><p>The five-vehicle numerical campaign applies five attacks from 10–15 s: position and speed biases, intermittent position and speed faults, and packet drops. The platform tests then compare rollback and trust-gated platoon control under real packet timing.</p></div>

      <div class="result-highlight-grid">
        {project.resultHighlights.map((result) => (
          <article class="result-highlight"><p class="result-value">{result.value}</p><h3>{result.title}</h3><p>{result.description}</p></article>
        ))}
      </div>

      <section class="experiment-block" aria-labelledby="aggregate-results-title">
        <div class="experiment-heading"><p class="small-label">Numerical campaign</p><h3 id="aggregate-results-title">Aggregate attack-window performance</h3><p>Raw combined state-estimation RMSE, trust response, source suppression, and average detection time by corruption mode.</p></div>
        <div class="experiment-table-wrap">
          <table class="experiment-table">
            <thead><tr><th scope="col">Mode</th><th scope="col">Mean RMSE</th><th scope="col">Std. dev.</th><th scope="col">Max. RMSE</th><th scope="col">Trust drop</th><th scope="col">Source zero</th><th scope="col">Detection time</th></tr></thead>
            <tbody>{project.aggregateResults.map((row) => <tr><th scope="row">{row.mode}</th><td>{row.meanRmse}</td><td>{row.standardDeviation}</td><td>{row.maximumRmse}</td><td>{row.trustDrop}</td><td>{row.sourceZero}</td><td>{row.detectionTime}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="result-note">The intermittent 10 m position fault (Case 2) was the dominant attack, with a cross-mode mean RMSE of 1.232. The other four cases remained below 0.405 in every tested configuration.</p>
      </section>

      <section class="experiment-block" aria-labelledby="rollback-results-title">
        <div class="experiment-heading"><p class="small-label">Rollback comparison</p><h3 id="rollback-results-title">Closed-loop XY trajectory RMSE</h3><p>Rollback moved the final estimate closer to the reference; adding accepted relative-pose anchoring produced the lowest reported trajectory error.</p></div>
        <div class="experiment-table-wrap">
          <table class="experiment-table">
            <thead><tr><th scope="col">Attack channel</th><th scope="col">No rollback</th><th scope="col">Rollback</th><th scope="col">Rollback + anchoring</th></tr></thead>
            <tbody>{project.trajectoryResults.map((row) => <tr><th scope="row">{row.channel}</th><td>{row.noRollback}</td><td>{row.rollback}</td><td class="best-result">{row.rollbackAnchoring}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="result-note">In the platform rollback trace, the position-estimation error reached approximately 0.8 m without rollback. Rollback reduced the error by 54.4% at the correction instant; rollback plus anchoring reduced it by 75.2%.</p>
      </section>

      <section class="experiment-block" aria-labelledby="control-results-title">
        <div class="experiment-heading"><p class="small-label">Trust-gated control</p><h3 id="control-results-title">Attack-window closed-loop metrics</h3><p>The attacked source received a mean observer weight below 0.05 for both hosts, while the projected minimum spacing stayed above the 0.30 m reporting margin.</p></div>
        <div class="experiment-table-wrap">
          <table class="experiment-table">
            <thead><tr><th scope="col">Host</th><th scope="col">Detection delay</th><th scope="col">CACC fusion gate</th><th scope="col">Attacked-source weight</th><th scope="col">Minimum spacing</th><th scope="col">Gap RMSE</th></tr></thead>
            <tbody>{project.controlResults.map((row) => <tr><th scope="row">{row.host}</th><td>{row.detectionDelay}</td><td>{row.caccGate}</td><td>{row.attackedSourceWeight}</td><td>{row.minimumSpacing}</td><td>{row.gapRmse}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="result-note result-caveat"><strong>Scope:</strong> this is a trust-gated ACC/CACC feasibility check with a path-projected spacing diagnostic. It is not a formal string-stability analysis or a full two-dimensional collision-avoidance guarantee.</p>
      </section>
    </section>

    <section id="citation" class="section-panel project-citation" aria-labelledby="citation-title">
      <div class="citation-heading"><h2 id="citation-title">Citation</h2><button class="copy-citation" type="button" hidden>Copy BibTeX</button></div>
      <p>{project.authors.join(', ')}. {project.title}. <em>{project.venue}</em>, {project.location}, {project.date}.</p>
      <pre><code id="bibtex">{ifacWc2026Citation}</code></pre>
      <p class="copy-status" role="status" aria-live="polite"></p>
    </section>
  </main>

  <footer class="site-footer container"><p>© {new Date().getFullYear()} {profile.name}</p><a href={`${base}/#publications`}>All publications <Icon name="arrow" size={15} /></a></footer>

  <script>
    const button = document.querySelector<HTMLButtonElement>('.copy-citation');
    const citation = document.getElementById('bibtex');
    const status = document.querySelector<HTMLElement>('.copy-status');
    if (button && citation && status && navigator.clipboard && window.isSecureContext) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(citation.textContent ?? '');
          status.textContent = 'BibTeX copied to clipboard.';
        } catch {
          status.textContent = 'Please select and copy the BibTeX text above.';
        }
      });
    }
  </script>
</BaseLayout>
