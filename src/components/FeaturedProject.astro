---
import Icon from './Icon.astro';
import { cep2026 } from '../data/cep2026';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class="featured-project" aria-labelledby="featured-project-title">
  <a class="featured-image" href={`${base}${cep2026.path}`} tabindex="-1">
    <img src={`${base}${cep2026.featuredImage.source}`} alt={cep2026.featuredImage.alt} width={cep2026.featuredImage.width} height={cep2026.featuredImage.height} loading="lazy" />
  </a>
  <div class="featured-copy">
    <p class="small-label">Featured research · CEP 2026</p>
    <h3 id="featured-project-title"><a href={`${base}${cep2026.path}`}>{cep2026.shortTitle}</a></h3>
    <p>Distributed estimation and control for vehicle platoons, evaluated on smooth and wavy roads in QLabs.</p>
    <a class="text-link" href={`${base}${cep2026.path}`}>Project & demonstration videos <Icon name="arrow" size={15} /></a>
  </div>
</article>
