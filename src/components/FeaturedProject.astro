---
import Icon from './Icon.astro';
import { featuredResearchProjects } from '../data/featuredResearch';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (path: string) => /^https?:\/\//.test(path) ? path : `${base}${path}`;
---

<div class="featured-grid">
  {featuredResearchProjects.map((project) => (
    <article class="featured-project" aria-labelledby={`${project.id}-title`}>
      {project.video && project.path ? (
        <a class="featured-image" href={`${base}${project.path}`} tabindex="-1">
          <video autoplay muted loop playsinline preload="metadata" width={project.video.width} height={project.video.height} aria-label={project.video.label}>
            <source src={`${base}${project.video.source}`} type="video/mp4" />
          </video>
        </a>
      ) : project.image && project.path ? (
        <a class="featured-image" href={`${base}${project.path}`} tabindex="-1">
          <img src={`${base}${project.image.source}`} alt={project.image.alt} width={project.image.width} height={project.image.height} loading="lazy" />
        </a>
      ) : (
        <div class="featured-image featured-image-placeholder" role="img" aria-label="Image placeholder"></div>
      )}
      <div class="featured-copy">
        <p class="featured-meta">
          <span>{project.venue}</span><span>{project.year}</span>
          {project.paperPath && <a class="button button-primary featured-paper-link" href={resolveHref(project.paperPath)} target="_blank" rel="noopener noreferrer">Paper Link <Icon name="arrow" size={13} /></a>}
        </p>
        <h3 id={`${project.id}-title`}>
          {project.path ? <a class="featured-title-link" href={`${base}${project.path}`}>{project.title}</a> : project.title}
          {project.path ? (
            <a class="button button-primary featured-details" href={`${base}${project.path}`} aria-label={`Details: ${project.title}`}>{project.actionLabel} <Icon name="arrow" size={13} /></a>
          ) : (
            <span class="featured-action-placeholder">{project.actionLabel}</span>
          )}
        </h3>
        <p class="featured-description">{project.description}</p>
      </div>
      <ul class="featured-highlights" aria-label="Key innovations">
        {project.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </article>
  ))}
</div>
